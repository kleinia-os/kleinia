[Unit]
ConditionPathExists=/run/initramfs/live
Description=Set liveuser empty password and configure GDM
After=systemd-sysusers.service
Before=display-manager.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/kleinia/live-password.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
