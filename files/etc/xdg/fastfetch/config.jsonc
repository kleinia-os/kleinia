// Kleinia preset for fastfetch.
// Install:  kleinia.txt  -> /usr/share/fastfetch/logos/kleinia.txt
//           config.jsonc -> /etc/xdg/fastfetch/config.jsonc   (or ~/.config/fastfetch/config.jsonc)
// Colour: Klein Light #3D63FF, readable on dark terminals.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "kleinia.txt",
    "color": { "1": "38;2;61;99;255" },
    "padding": { "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;61;99;255", "title": "38;2;61;99;255" },
    "separator": "  "
  },
  "modules": [
    "title", "separator",
    "os", "kernel", "uptime", "packages", "shell", "de", "terminal",
    "cpu", "gpu", "memory", "disk",
    "break", "colors"
  ]
}
